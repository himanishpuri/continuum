# =============================================================================
# Continuum — environment configuration
#
# Copy this file to `.env.local` and fill in the values you need.
# The application runs fully in DEMO_MODE with none of the Firebase/Gemini
# variables set — see README.md "Demo mode" for details.
# =============================================================================

# --- Demo mode -------------------------------------------------------------
# When "true": auth accepts a local demo session, data is persisted to local
# JSON files under .demo-data/, and the agent uses the deterministic
# DemoAgentProvider instead of calling Gemini. Set to "false" once Firebase
# and Gemini credentials below are configured for a production-like run.
DEMO_MODE=true

# --- Gemini / Genkit ---------------------------------------------------------
# API key from https://aistudio.google.com/apikey. Required for the real
# GeminiAgentProvider; unused while DEMO_MODE=true.
GEMINI_API_KEY=
# Concrete model id passed to Genkit's googleAI plugin. Pin a real one and
# bump deliberately — the gemini-flash-latest alias routes to the newest
# preview model, which is often overloaded (503).
GEMINI_MODEL=gemini-3.5-flash

# --- Firebase (client — safe to expose to the browser) ----------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — NEVER expose to the browser) -------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes when pasting a private key into a single line.
FIREBASE_PRIVATE_KEY=

# --- Session / background job security --------------------------------------
# Signs the demo/production session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-in-production
# Shared secret Cloud Scheduler must send as `X-Cron-Secret` when calling
# POST /api/cron/run-due-checkins in production.
CRON_SECRET=change-me-in-production
