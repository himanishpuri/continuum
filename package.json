{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "rimraf .demo-data-test && vitest run",
    "eval": "rimraf .demo-data-eval && vitest run -c vitest.eval.config.ts --reporter=verbose",
    "eval:compare": "node --import tsx evals/compare.ts",
    "prompts:publish": "node --import tsx scripts/publish-prompts.ts",
    "prompts:promote": "node --import tsx scripts/promote-prompt.ts",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-demo.ts",
    "vercel:env": "bash scripts/vercel-env.sh"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.41.0",
    "@genkit-ai/middleware": "^0.9.0",
    "@langfuse/client": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "genkit": "^1.41.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
