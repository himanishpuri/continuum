rules_version = '2';

// Continuum's Next.js server is the only thing that ever reads or writes
// Firestore — every route handler uses the Firebase Admin SDK (which
// bypasses these rules entirely) and derives the caller's identity from a
// verified session cookie, never from a client-supplied field. The client
// Firebase SDK is used only for Authentication, never for Firestore.
//
// Because there is no legitimate direct-client data path to begin with,
// the simplest rule that is also maximally correct is to deny all direct
// client reads and writes outright. This trivially satisfies "users can
// only access their own data" and "no client writes to privileged fields
// (approved, executedAt, policyDecision, ...)" — there is no field a
// client can reach to tamper with in the first place.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
